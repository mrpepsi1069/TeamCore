DISCORD_TOKEN=your-bot-token
DATABASE_URL=mongodb+srv://user:pass@cluster/...
PORT=3000

# Optional overrides (defaults are the previous hard-coded values)
# BOT_OWNER_ID=
# SUGGESTION_CHANNEL_ID=
# LOG_GUILD_ID=
# TEMPLATE_GUILD_ID=
# SUPPORT_SERVER_URL=
# PUBLIC_GUILD_LIST=1          # set 0 to stop /api/guilds listing your servers publicly
# MONGO_ALLOW_INVALID_CERTS=0  # only if your host has a broken CA bundle
