# ───────── Shared ─────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority   # (the bot also accepts DATABASE_URL)
MONGODB_DB=lockerroom_bot

# ───────── Bot (bot host only) ─────────
DISCORD_TOKEN=your-bot-token                  # NEVER put this on the backend or in the frontend
PORT=3000                                     # bot health-check port
# BOT_OWNER_ID=  SUGGESTION_CHANNEL_ID=  LOG_GUILD_ID=  TEMPLATE_GUILD_ID=  SUPPORT_SERVER_URL=   (optional overrides)
# PUBLIC_GUILD_LIST=1   MONGO_ALLOW_INVALID_CERTS=0

# ───────── Backend (backend host only) ─────────
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret
BACKEND_URL=https://api.example.com           # public URL of this FastAPI app (OAuth redirect: BACKEND_URL/auth/callback)
FRONTEND_URL=https://USERNAME.github.io/TeamCore   # where the site lives (base URL, no trailing slash)
# ALLOWED_ORIGINS=https://USERNAME.github.io  # comma-separated; defaults to the origin of FRONTEND_URL. Never *.
DATA_ENCRYPTION_KEY=generate-with-command-below   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_TTL_DAYS=7
# SERVE_FRONTEND=1                            # optional: serve /frontend from the backend itself (single-host mode)
