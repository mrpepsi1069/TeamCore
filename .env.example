# Copy this file to .env and fill in your own values.
# Never commit your real .env file — it contains secrets.

# Bot token from the Discord Developer Portal (Bot tab)
DISCORD_TOKEN=

# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net)
DATABASE_URL=

# Port for the built-in HTTP health-check server (optional, defaults to 3000)
PORT=3000
